---
// Decorative snowfall, rendered with a plain canvas element.
// No framework runtime is loaded for this effect: Astro bundles the
// small script below and the page ships zero JavaScript for it by default
// beyond this one inline module.
---

<div class="snowfall-overlay" aria-hidden="true">
  <canvas id="snowfall-canvas"></canvas>
</div>

<style>
  .snowfall-overlay canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const canvas = document.getElementById("snowfall-canvas");
  if (canvas instanceof HTMLCanvasElement) {
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!motion.matches) {
      const context = canvas.getContext("2d");
      if (context) {
        const FLAKE_COUNT = 80;
        const COLOR = "#b4cbd3";
        let width = 0;
        let height = 0;

        const resize = () => {
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.floor(width * ratio);
          canvas.height = Math.floor(height * ratio);
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
        };
        resize();
        window.addEventListener("resize", resize);

        const flakes = Array.from({ length: FLAKE_COUNT }, () => ({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          radius: 1 + Math.random() * 2.5,
          speed: 0.3 + Math.random() * 0.9,
          sway: 0.4 + Math.random() * 0.8,
          phase: Math.random() * Math.PI * 2,
        }));

        const draw = (time) => {
          context.clearRect(0, 0, width, height);
          context.fillStyle = COLOR;
          for (const flake of flakes) {
            flake.y += flake.speed;
            flake.x += Math.sin(time / 1600 + flake.phase) * flake.sway * 0.2;
            if (flake.y > height + flake.radius) {
              flake.y = -flake.radius;
              flake.x = Math.random() * width;
            }
            context.beginPath();
            context.arc(flake.x, flake.y, flake.radius, 0, Math.PI * 2);
            context.fill();
          }
          requestAnimationFrame(draw);
        };
        requestAnimationFrame(draw);
      }
    }
  }
</script>
