---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../data/languages";
import { pickLocalizedText } from "../lib/localizedText";

type SocialLink = Extract<
  CollectionEntry<"links">["data"],
  { group: "social" }
>;

interface Props {
  links: SocialLink[];
  heading: string;
  locale: Locale;
}

const { links, heading, locale } = Astro.props;
---

<section class="links-section" aria-labelledby={`${heading}-heading`}>
  <div class="section-heading-row">
    <h2 id={`${heading}-heading`}>{heading}</h2>
  </div>

  <div class="portal-link-list">
    {links.map((link) => {
      const label = pickLocalizedText(link.label, locale) ?? "";
      return (
        <a
          class="portal-link"
          href={link.href}
          target={link.copy ? undefined : "_blank"}
          rel={link.rel}
          data-id={link.copy}
          data-label={link.copy ? label.split(" · ")[0] : undefined}
        >
          <img
            class="portal-link-icon"
            src={`/images/icons/${link.icon}`}
            alt=""
            width="24"
            height="24"
            aria-hidden="true"
          />
          <span class="portal-link-text">
            {label}
          </span>
          <span class="portal-link-arrow" aria-hidden="true">→</span>
        </a>
      );
    })}
  </div>
</section>
