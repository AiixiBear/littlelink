---
import type { CollectionEntry } from "astro:content";

type HomeContent = CollectionEntry<"home">["data"];

interface Props {
  cards: HomeContent["aboutCards"];
}

const { cards } = Astro.props;
---

<div class="info-card-list">
  {cards.map((card) => (
    <div class="info-card">
      <h3>{card.title}</h3>
      <div class="info-card-content">
        {card.lines.map((line) => (
          <p>
            {line.map((part) =>
              part.id ? (
                <span id={part.id} class={part.class}>{part.text}</span>
              ) : part.strong ? (
                <strong class={part.class}>{part.text}</strong>
              ) : (
                part.text
              )
            )}
          </p>
        ))}
      </div>
    </div>
  ))}
</div>
