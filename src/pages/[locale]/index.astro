---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProfileHeader from "../../components/ProfileHeader.astro";
import InfoCards from "../../components/InfoCards.astro";
import PortalLinks from "../../components/PortalLinks.astro";
import { languages } from "../../data/languages";
import { locales, type Locale } from "../../data/locales";
import { socialLinks, websiteLinks } from "../../data/site";

export function getStaticPaths() {
  return Object.entries(locales).map(([locale, content]) => ({
    params: { locale },
    props: { locale: locale as Locale, content },
  }));
}

const { locale, content } = Astro.props;
const pageScript = "/js/portal.js";
const languageOptions = languages.map((language) => ({
  ...language,
  selected: language.key === locale,
}));
---

<SiteLayout
  locale={locale}
  pageTitle={content.title}
  description={content.description}
  ogDescription={content.ogDescription}
  ogSiteName={content.ogSiteName}
  ogImageAlt={content.ogImageAlt}
  jsonLdName={content.jsonLdName}
  footerTitle={content.footerTitle}
  versionLabel={content.versionLabel}
  pageScript={pageScript}
>
  <div class="portal-page">
    <ProfileHeader content={content} languages={languages} languageOptions={languageOptions} />

    <section class="quick-links" aria-labelledby="quick-links-heading">
      <h2 id="quick-links-heading">{content.quickLinksHeading}</h2>
      <div class="quick-link-grid">
        <a class:list={["quick-link", content.quickLinkClasses.about]} href="https://www.aiixi.cc/about/" target="_blank" rel="noopener">
          <span>{content.aboutLink}</span>
          <span aria-hidden="true">→</span>
        </a>
        {websiteLinks.map((link) => (
          <a class:list={["quick-link", content.quickLinkClasses[link.id]]} href={link.href} target="_blank" rel={link.rel}>
            <span>{link.key ? content[link.key] : link.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="about-heading">
      <div class="section-heading-row">
        <h2 id="about-heading">{content.aboutHeading}</h2>
      </div>
      <InfoCards cards={content.aboutCards} />
      <br>
      <a class:list={["quick-link", content.quickLinkClasses.about]} href="https://www.aiixi.cc/about/" target="_blank" rel="noopener">
          <span>{content.aboutLink}</span>
          <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="media-section" aria-labelledby="media-heading">
      <div class="section-heading-row">
        <h2 id="media-heading">{content.mediaHeading}</h2>
      </div>
      <figure class="media-card">
        <picture>
          <source media="(min-width: 768px)" srcset="/images/nene2.webp" />
          <img src="/images/nene1.webp" alt={content.mediaImageAlt} width="1200" height="630" loading="lazy" />
        </picture>
        <figcaption>{content.mediaCaption}</figcaption>
      </figure>
      <figure class="media-card">
        <lite-youtube
          videotitle="ロミオとシンデレラ / 日野森雫（アナザーボーカル Full ver.）"
          videoid="HD3v90A3ldg"
          posterquality="maxresdefault"
        ></lite-youtube>
        <figcaption>{content.videoTitle}</figcaption>
      </figure>
    </section>

    <PortalLinks links={socialLinks} content={content} heading={content.socialHeading} />
  </div>
</SiteLayout>

<script>
  import '@justinribeiro/lite-youtube';
</script>
