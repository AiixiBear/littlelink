---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProfileHeader from "../../components/ProfileHeader.astro";
import InfoCards from "../../components/InfoCards.astro";
import PortalLinks from "../../components/PortalLinks.astro";
import InspirationSection from "../../components/InspirationSection.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { languages, type Locale } from "../../data/languages";
import { getLatestArticle } from "../../lib/latestArticle";
import { pickLocalizedText } from "../../lib/localizedText";

export function getStaticPaths() {
  return languages.map((language) => ({
    params: { locale: language.key },
    props: { locale: language.key },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const entry = await getEntry("home", locale);
if (!entry) throw new Error(`Missing home content for locale "${locale}"`);
const content = entry.data;
const pageScript = "/js/portal.js";
const latestArticle = await getLatestArticle(locale);
const latestArticleDate = latestArticle
  ? new Intl.DateTimeFormat(content.lang, {
      timeZone: "Asia/Taipei",
      year: "numeric",
      month: "short",
      day: "numeric",
    }).format(latestArticle.publishedAt)
  : null;
const languageOptions = languages.map((language) => ({
  ...language,
  selected: language.key === locale,
}));
// getCollection returns entries sorted by id, not file order, so both
// collections are sorted by their explicit "order" field here.
const inspirationItems = (await getCollection("inspiration"))
  .map((item) => item.data)
  .sort((a, b) => a.order - b.order);
type LinkItem = CollectionEntry<"links">["data"];
const allLinks = (await getCollection("links"))
  .map((item) => item.data)
  .sort((a, b) => a.order - b.order);
const websiteLinks = allLinks.filter(
  (link): link is Extract<LinkItem, { group: "website" }> =>
    link.group === "website",
);
const socialLinks = allLinks.filter(
  (link): link is Extract<LinkItem, { group: "social" }> =>
    link.group === "social",
);
---

<SiteLayout
  locale={locale}
  pageTitle={content.title}
  description={content.description}
  ogDescription={content.ogDescription}
  ogSiteName={content.ogSiteName}
  ogImageAlt={content.ogImageAlt}
  jsonLdName={content.jsonLdName}
  footerTitle={content.footerTitle}
  versionLabel={content.versionLabel}
  pageScript={pageScript}
>
  <div class="portal-page">
    <ProfileHeader content={content} languages={languages} languageOptions={languageOptions} />

    <section class="quick-links" aria-labelledby="quick-links-heading">
      <h2 id="quick-links-heading">{content.quickLinksHeading}</h2>
      <div class="quick-link-grid">
        <a class:list={["quick-link", content.quickLinkClasses.about]} href="https://www.aiixi.cc/about/" target="_blank" rel="noopener">
          <span>{content.aboutLink}</span>
          <span aria-hidden="true">→</span>
        </a>
        {websiteLinks.map((link) => (
          <div class:list={["quick-link-group", link.latestArticle && "quick-link-group-homepage", link.latestArticle && latestArticle && "has-latest-article"]}>
            <a class:list={["quick-link", link.primary && "quick-link-primary"]} href={link.href} target="_blank" rel={link.rel}>
              <span>{pickLocalizedText(link.label, locale)}</span>
              <span aria-hidden="true">→</span>
            </a>
            {link.latestArticle && latestArticle && latestArticleDate && (
              <details class="latest-article">
                <summary class="latest-article-summary">
                  {locale === "en" ? "Latest article | " : locale === "ja" ? "最新記事 | " : "最新文章 | "}
                  {latestArticle.title} ({latestArticleDate})
                </summary>
                <a class="latest-article-link" href={latestArticle.href} target="_blank" rel="noopener">
                  {latestArticle.coverHref && (
                    <img class="latest-article-image" src={latestArticle.coverHref} alt="" loading="lazy" />
                  )}
                  <div class="latest-article-content">
                    <span>{latestArticle.title}</span>
                    <time class="latest-article-date" datetime={latestArticle.publishedAt.toISOString()}>{latestArticleDate}</time>
                    <p>{latestArticle.description}</p>
                  </div>
                </a>
              </details>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="about-heading">
      <div class="section-heading-row">
        <h2 id="about-heading">{content.aboutHeading}</h2>
      </div>
      <InfoCards cards={content.aboutCards} />
      <br>
      <a class:list={["quick-link", content.quickLinkClasses.about]} href="https://www.aiixi.cc/about/" target="_blank" rel="noopener">
          <span>{content.aboutLink}</span>
          <span aria-hidden="true">→</span>
      </a>
    </section>

    <InspirationSection heading={content.mediaHeading} items={inspirationItems} locale={locale} />

    <PortalLinks links={socialLinks} heading={content.socialHeading} locale={locale} />
  </div>
</SiteLayout>
