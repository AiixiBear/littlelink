---
import { languages } from "../data/languages";
import { locales, type Locale } from "../data/locales";
import SnowfallOverlay from "../components/SnowfallOverlay";

interface Props {
  locale: Locale;
  pageTitle: string;
  description: string;
  ogDescription: string;
  ogImageAlt: string;
  ogSiteName: string;
  jsonLdName: string;
  footerTitle: string;
  versionLabel: string;
  pageScript: string;
}

const {
  locale,
  pageTitle,
  description,
  ogDescription,
  ogImageAlt,
  ogSiteName,
  jsonLdName,
  footerTitle,
  versionLabel,
  pageScript,
} = Astro.props;
const path = languages.find((language) => language.key === locale)?.path;
if (!path) throw new Error(`Missing route for locale "${locale}"`);
const canonical = `https://go.aiixi.cc${path}`;
const page = locales[locale];
---

<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Aiixi Bear" />
    {languages.map((language) => (
      <link rel="alternate" hreflang={language.locale} href={`https://go.aiixi.cc${language.path}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://go.aiixi.cc/zh-tw/" />
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/portal.css" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content="https://www.aiixi.cc/img/aiixi_go.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://www.aiixi.cc/img/aiixi_go.webp" />
    <meta name="yandex-verification" content="af664e13bded830e" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      url: canonical,
      name: jsonLdName,
    })}></script>
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-KFGS9HND"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
  </head>
  <body>
    <SnowfallOverlay client:load />
    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>{footerTitle}</p>
      <p>Made by Aiixi Bear in Poland &amp; Taiwan</p>
      <p>
        <small>
          {versionLabel}
          <a href="https://github.com/AiixiBear/littlelink/commit/COMMIT_HASH_PLACEHOLDER">
            COMMIT_HASH_PLACEHOLDER
          </a>
          {" | "}
          <a href="https://github.com/AiixiBear/littlelink">GitHub Repo</a>
        </small>
      </p>
    </footer>

    <div id="sakura-container"></div>

    <script is:inline src="/js/lang_menu.js"></script>
    <script is:inline src="/js/sakura.js"></script>
    <script is:inline src={pageScript}></script>
  </body>
</html>
