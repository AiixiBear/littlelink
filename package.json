{
  "name": "littlelink",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "astro build && html-beautify --replace --type html --indent-size 2 --wrap-line-length 100 --no-preserve-newlines --indent-inner-html --end-with-newline \"dist/**/*.html\"",
    "dev": "astro dev",
    "preview": "astro preview"
  },
  "devDependencies": {
    "astro": "^7.3.5",
    "js-beautify": "^1.15.4"
  },
  "dependencies": {
    "node": "^22.23.3"
  }
}
